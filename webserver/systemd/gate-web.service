[Unit]
Description=Gate web service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/workspace/webserver
Environment=HOME=/home/ubuntu
Environment=XDG_RUNTIME_DIR=/tmp/gate-runtime
ExecStart=/usr/bin/python3 /workspace/webserver/server.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
